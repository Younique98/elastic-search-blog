# Copy to .env (in this starter-kit/ directory) and fill in your own
# Elasticsearch connection. Same variable names as the parent blog repo
# this kit was extracted from, so if you're comparing the two side by
# side nothing is renamed for no reason.

# Use ES_URL for a self-hosted cluster (including a local Docker
# container — see README.md's "Local Elasticsearch with Docker"
# section), or ES_CLOUD_ID for Elastic Cloud/Serverless. Prefer
# ES_API_KEY over a username/password where possible.
ES_URL=http://localhost:9200
# ES_CLOUD_ID=
# ES_API_KEY=
# ES_USERNAME=
# ES_PASSWORD=

# The inference endpoint hybrid_search uses for semantic embeddings.
# Defaults to Elastic's built-in ELSER endpoint, preconfigured on
# Elastic Cloud and Serverless. Only set this if your cluster uses a
# different endpoint id. If your cluster has none at all, hybrid_search
# falls back to lexical-only (BM25) search automatically — see
# README.md's "Graceful fallback" section for how to actually verify
# that on your own cluster.
# ES_INFERENCE_ID=.elser-2-elasticsearch
