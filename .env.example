# Copy this file to .env and fill in real values for your environment.
# .env is gitignored and must never be committed.

# Required in production. Signs CSRF tokens and any session/cookie data.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Elasticsearch connection. Use ES_URL for a self-hosted cluster, or
# ES_CLOUD_ID for Elastic Cloud. Prefer ES_API_KEY over a username/password
# where possible.
ES_URL=http://localhost:9200
# ES_CLOUD_ID=
# ES_API_KEY=
# ES_USERNAME=
# ES_PASSWORD=

# Inference endpoint used for semantic (hybrid) retrieval. Defaults to
# Elastic's built-in sparse-embedding endpoint, preconfigured on Elastic
# Cloud and Serverless — no external embedding model or API key needed.
# Only set this if your cluster uses a different endpoint id (e.g. a
# self-managed cluster with ELSER deployed under a custom name, or a
# dense-vector endpoint like .multilingual-e5-small-elasticsearch). If
# this cluster has no usable inference endpoint at all, the app falls
# back to lexical-only (BM25) search automatically rather than failing.
# ES_INFERENCE_ID=.elser-2-elasticsearch

# Admin account for the /admin content-management panel. This is a
# self-hosted, single-operator product — one admin account, not a user
# database. Never put the plaintext password here; generate the hash with:
#   flask hash-password 'your-chosen-password'
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Stripe — sells the Elasticsearch Search Starter Kit as a one-time
# $49 purchase (see billing.py; no subscription/paywall on the blog
# itself, all posts stay free). Get these from the Stripe Dashboard:
#   STRIPE_SECRET_KEY      — Developers -> API keys (use a *test* key
#                             while developing; sk_live_... in production).
#   STRIPE_PRICE_ID        — Product catalog -> create a one-time-payment
#                             ($49) Price for the Starter Kit -> its ID
#                             (price_...). Not a Product ID.
#   STRIPE_WEBHOOK_SECRET  — Developers -> Webhooks -> add an endpoint at
#                             <your-domain>/stripe/webhook listening for
#                             checkout.session.completed -> its signing
#                             secret (whsec_...). Locally, use the Stripe
#                             CLI: `stripe listen --forward-to
#                             localhost:5001/stripe/webhook`, which prints
#                             a whsec_... for you to use.
# The /starter-kit page and its "Buy" button work without these set, but
# checkout is disabled (billing.is_configured() gates it) until all
# three are present.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Postgres — where newsletter subscribers and Starter Kit purchases are
# stored (see store.py). This app deploys as a single Vercel Python
# serverless function (api/index.py), which has no persistent local
# filesystem across requests, so this can't be a local file/SQLite —
# it has to be a real hosted database. Same pattern as Erica's other
# repos: add the Neon integration from the Vercel Storage tab (or any
# other Postgres host) and it sets this for you; DATABASE_URL should
# look like postgres://user:password@host/dbname?sslmode=require.
# Without it, the rest of the site (search, admin, individual posts)
# still works — only newsletter signup and Starter Kit checkout do not.
DATABASE_URL=

# Resend — sends the automated Starter Kit purchase/delivery email (see
# notifications.py). Same service already integrated in Erica's
# Windless Technologies repo's contact form.
#   RESEND_API_KEY    — from the Resend dashboard (API Keys).
#   RESEND_FROM_EMAIL — optional; the verified sending address, e.g.
#                        "RetrievalKit <kit@yourdomain.com>". Defaults
#                        to Resend's own onboarding@resend.dev sender,
#                        which works unverified but is best replaced
#                        with a domain Erica has verified in Resend.
# Without RESEND_API_KEY, purchases are still recorded normally — the
# confirmation email just isn't sent (see notifications.is_configured()).
RESEND_API_KEY=
# RESEND_FROM_EMAIL=

# The actual Starter Kit download. The kit's contents now live at
# static/starter-kit.zip in this repo (built from starter-kit/ by
# scripts/build_starter_kit_zip.sh and committed like any other static
# asset), served by this same Flask app — so no separate file host
# (S3, a GitHub release, Gumroad) is required. Set this to that file's
# full URL on your deployed domain, e.g.:
#   STARTER_KIT_FILE_URL=https://your-deployed-domain.example/static/starter-kit.zip
# Left unset, the purchase email tells the buyer their download is
# coming within 24 hours instead of sending a broken link. Setting this
# needs no code change — every purchase email after that will include
# the real link.
# STARTER_KIT_FILE_URL=
